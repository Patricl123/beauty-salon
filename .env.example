# Copy to .env.local. Do not commit .env.local or paste its contents into chat.
# demo = isolated local preview; supabase = PostgreSQL + real admin authentication.
VITE_DATA_SOURCE=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Browser-safe publishable key from Supabase > Settings > API Keys.
# Never put a secret key, service_role key, database password, or JWT secret here.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
# Turnstile SECRET belongs only in supabase/functions/.env / Edge Function Secrets.

# Optional, only for `npm run test:db:live` against an EMPTY DISPOSABLE database.
# It is a server-only variable: never prefix with VITE_. Leave blank normally.
TEST_DATABASE_URL=
