# Server runtime only. Copy to supabase/functions/.env; never commit the real file.
TURNSTILE_SECRET_KEY=REPLACE_LOCALLY
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
BOOKING_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SITE_MEDIA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.
# Do NOT copy a service role key into frontend .env.local or any VITE_* variable.

